generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String?  @unique
  /// 工号，SSO 自动开通用户的唯一标识；本地管理员账号可为空
  employeeId   String?  @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  balance      Decimal  @default(0)
  /// 月度额度的上次重置时间(跨月首次调用时把 balance 重置为月度额度)
  balanceResetAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys      ApiKey[]
  bills        Bill[]
  transactions Transaction[]
  auditLogs    AuditLog[]
}

enum Role {
  ADMIN
  USER
}

model Provider {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  type      ProviderType
  baseUrl   String
  path      String         @default("/chat/completions")
  apiKey    String
  status    ProviderStatus @default(ACTIVE)
  createdAt DateTime       @default(now())

  models       Model[]
  protocols    ProviderProtocol[]
  usageRecords UsageRecord[]
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  HUGGINGFACE
  DEEPSEEK
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

model Model {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  providerId  Int
  provider    Provider @relation(fields: [providerId], references: [id])
  status      String   @default("ACTIVE")
  /// 计价单位：$/百万 token（inputPrice 输入、outputPrice 输出、cachePrice 缓存命中输入）
  inputPrice  Decimal  @default(0)
  outputPrice Decimal  @default(0)
  cachePrice  Decimal  @default(0)
  createdAt   DateTime @default(now())

  allowedKeys ApiKeyAllowedModel[]
}

model ApiKey {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id])
  keyHash      String       @unique
  /// 明文 key 的 AES 加密副本，仅供 SSO 交换端点重复发放，永不通过普通接口返回
  keyEncrypted String?
  name         String
  status       ApiKeyStatus @default(ACTIVE)
  /// 工作台自动创建/托管的密钥：自动开通与用量统计按其归属，非管理员不可删除
  isSystem     Boolean      @default(false)
  rateLimit    Int          @default(60)
  /// 日/月 token 配额，0 = 不限
  dailyQuota   BigInt       @default(0)
  monthlyQuota BigInt       @default(0)
    expiresAt    DateTime?
    createdAt    DateTime     @default(now())
    /// 逻辑删除时间：非空表示已删除。列表与使用统计都排除；用量/账单记录因外键保留。
    deletedAt    DateTime?

    usageRecords  UsageRecord[]
    allowedModels ApiKeyAllowedModel[]
  }

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model ApiKeyAllowedModel {
  apiKeyId     Int
  apiKey       ApiKey @relation(fields: [apiKeyId], references: [id])
  modelId      Int
  model        Model  @relation(fields: [modelId], references: [id])
  /// 按模型的日/月 token 配额，0 = 不限
  dailyQuota   BigInt @default(0)
  monthlyQuota BigInt @default(0)

  @@id([apiKeyId, modelId])
}

model UsageRecord {
  id           Int      @id @default(autoincrement())
  apiKeyId     Int
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])
  providerId   Int
  provider     Provider @relation(fields: [providerId], references: [id])
  model        String
  tokensIn     Int      @default(0)
  tokensOut    Int      @default(0)
  cachedTokens Int      @default(0)
  cost         Decimal  @default(0)
  latencyMs    Int      @default(0)
  createdAt    DateTime @default(now())
}

model Bill {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  totalCost   Decimal
  status      BillStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
}

model Transaction {
  id          Int             @id @default(autoincrement())
  userId      Int
  user        User            @relation(fields: [userId], references: [id])
  type        TransactionType
  amount      Decimal
  balance     Decimal
  description String?
  createdAt   DateTime        @default(now())
}

enum TransactionType {
  RECHARGE
  CONSUMPTION
  REFUND
}

enum Protocol {
  OPENAI_CHAT
  OPENAI_RESPONSES
  ANTHROPIC_MESSAGES
}

model ProviderProtocol {
  id         Int      @id @default(autoincrement())
  providerId Int
  provider   Provider @relation(fields: [providerId], references: [id])
  protocol   Protocol
  path       String?
  status     ProviderStatus @default(ACTIVE)
  createdAt  DateTime @default(now())

  @@unique([providerId, protocol])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([targetType])
  @@index([userId])
}
