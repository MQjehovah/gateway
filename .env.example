# Database (PostgreSQL)
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_gateway

# 运行环境:production/prod(大小写不敏感)下缺失或弱 secret 会拒绝启动;默认 development
APP_ENV=development

# CORS 白名单(逗号分隔,控制台/网关允许的浏览器来源);默认仅本机
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT(生产必须替换为随机强密钥;change-me 属于弱值)
JWT_SECRET=change-me

# Internal
INTERNAL_SECRET=change-me

# Admin 会话(控制台 JWT)有效期,默认 12h
# 纯数字按"秒"解释(如 43200 = 12h);也接受 <n>s|m|h|d 时间跨度;须为正数,非法值启动即失败
ADMIN_SESSION_TTL=12h

# OIDC SSO（配置后浏览器 SSO 登录与 router token 验签可用）
OIDC_ISSUER=https://idp.example.com
OIDC_AUDIENCE=gateway-admin
# 员工端 dashboard 交换出的 gateway token 受众（用户态接口验签用）；默认 gateway（兼容旧 router 受众）
# SSO_GATEWAY_AUDIENCE=gateway
# 工号 claim 名，默认依次尝试 employee_number/employeeNumber/employee_id 等，最后回退 sub
# OIDC_EMPLOYEE_ID_CLAIM=employee_number
# 可选：直接指定 JWKS 地址，跳过 discovery（容器内解析不到公网域名时很有用）
# OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json

# 浏览器「企业 SSO 登录」（授权码流程）：issuer + client_id + redirect_uri 齐备后 /api/auth/sso/start 可用
# 注意回调地址需在 IdP 侧登记；OIDC_REDIRECT_TARGET 是本控制台登录页路径（子路径部署时为 /gateway/login）
OIDC_CLIENT_ID=gateway-admin
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://ai.example.com/gateway/api/auth/oidc/callback
OIDC_REDIRECT_TARGET=/gateway/login
# SSO 自动开通账号的默认角色（留空=USER；需自动授予管理员时设 ADMIN）
# SSO_DEFAULT_ROLE=
# SSO 自动开通账号的初始额度
# SSO_INITIAL_BALANCE=1000000

# Encryption(生产必须替换为 32 字节随机密钥;change-me 属于弱值)
ENCRYPTION_KEY=change-me

# Admin Password（必填:脚本要求非弱口令,未设置或命中弱值清单将直接失败退出）
ADMIN_PASSWORD=change-me

# Provider API Keys(生产必须替换;change-me 占位值属于弱值,禁止直接上线)
OPENAI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me
GOOGLE_API_KEY=change-me
HUGGINGFACE_API_KEY=change-me
DEEPSEEK_API_KEY=change-me
